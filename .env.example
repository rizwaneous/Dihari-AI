# --- core ---
DATABASE_URL=sqlite:///./dihari.db          # docker-compose overrides this with Postgres+PostGIS
SECRET_KEY=change-me-in-production
DEV_MODE=true                               # returns the OTP in the API response when SMS_PROVIDER=stub. NEVER true in production.
DEFAULT_COUNTRY=PK
SEED_DEMO=true

# --- AI providers: LEFT EMPTY ON PURPOSE (mocks only). Add real providers per docs/PROVIDERS.md ---
# Comma-separated fallback chains; first = primary. Names must be registered in backend/app/ai/providers/.
ASR_PROVIDERS=mock
TTS_PROVIDERS=mock
LLM_EXTRACT_PROVIDERS=mock-a
LLM_VERIFY_PROVIDERS=mock-b                 # MUST be a different model family than the extractor
# ASR_API_KEY=
# TTS_API_KEY=
# LLM_EXTRACT_API_KEY=
# LLM_VERIFY_API_KEY=
# --- Google Gemini: one key powers job extraction, Urdu speech-to-text and read-aloud ---
# Get a key at https://aistudio.google.com . Put the real key ONLY in backend/.env (git ignores it).
# GEMINI_API_KEY=
# ASR_PROVIDERS=gemini,mock
# TTS_PROVIDERS=gemini,mock
# LLM_EXTRACT_PROVIDERS=gemini,mock-a
# LLM_VERIFY_PROVIDERS=mock-b          # placeholder: set a second, non-Gemini model (e.g. Claude or GPT) here later
# GEMINI_TEXT_MODELS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# MOCK_ASR_FIXED_TEXT=four workers tomorrow 8am tile work in G-13 1500 a day   # demo without a microphone/ASR

# --- messaging: stub only ---
SMS_PROVIDER=stub
NOTIFY_PROVIDERS=log                        # order of push providers; SMS is always the last fallback
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- abuse controls ---
RATE_LIMIT_ENABLED=true
MAX_JOBS_PER_HIRER_PER_DAY=10
MAX_OPEN_JOBS_PER_HIRER=5
MAX_POSTS_PER_HIRER_PER_HOUR=5
# --- demo accounts (one-tap hirer + labourer, only while DEV_MODE=true) ---
DEMO_LOGINS=true
REPORTS_TO_FLAG_JOB=3

# --- scheduler (payment-day reminders) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# --- demo reviewer (seed) ---
DEMO_REVIEWER_TOKEN=demo-reviewer-token

# Optional external delivery. Configure the backend .env with your own sender credentials.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NOTIFY_PROVIDERS=webpush,log
# VAPID_SUBJECT=mailto:operator@example.com

# WhatsApp Cloud API (placeholder: leave empty to skip WhatsApp notifications)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
